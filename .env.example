# Copy this file to .env and fill in your Grafana Cloud OTLP details.
# Get these from: Grafana Cloud Portal -> your stack ->
# Connections -> Add new connection -> OpenTelemetry. That page shows the
# exact endpoint + instance ID for your stack and can generate a scoped
# token for you ("Generate now" button).

# Usually: https://otlp-gateway-<region>.grafana.net/otlp
# Example (region prod-us-east-0):
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp

# "Instance ID" shown on that same OpenTelemetry connection page (this is
# NOT the stack slug - it's a numeric id).
GRAFANA_CLOUD_INSTANCE_ID=

# A Grafana Cloud Access Policy token scoped to at least metrics:write and
# traces:write for this stack.
GRAFANA_CLOUD_API_TOKEN=

# Number of persistent FrankenPHP workers (worker mode).
FRANKENPHP_NUM_WORKERS=2
